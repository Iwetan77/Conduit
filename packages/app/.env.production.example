# Production/staging template for the single Conduit app.
# NEXT_PUBLIC_* values are inlined into the browser bundle AT BUILD TIME —
# changing one requires a rebuild, not just a restart.

NEXT_PUBLIC_CONDUIT_API_URL=https://your-api-host
NEXT_PUBLIC_APP_URL=https://your-app-host

# Circle Wallets — Google sign-in. Both required together; without them the
# Google button is hidden and only wallet connection works.
#
# The Google client id must list this app's origin as an authorised JavaScript
# origin AND "<origin>/auth/circle/callback" as an authorised redirect URI.
# Circle's SDK navigates the whole tab to Google, so a mismatch here fails as
# redirect_uri_mismatch at Google, well away from anything that mentions it.
#
# Replaced NEXT_PUBLIC_PRIVY_APP_ID, removed in Phase 7.
NEXT_PUBLIC_CIRCLE_APP_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# From cloud.walletconnect.com. Without it, mobile wallets cannot connect —
# only browser-extension wallets and Google sign-in work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deployed contract addresses. The SDK refuses to fall back to hardcoded
# values, so a missing one surfaces as a visible error, never a wrong address.
NEXT_PUBLIC_CONDUIT_ROUTER=
NEXT_PUBLIC_DECLARATION_REGISTRY=
NEXT_PUBLIC_STABLEFX_ADAPTER=
NEXT_PUBLIC_ATOMIC_SETTLER=
NEXT_PUBLIC_CURRENCY_REGISTRY=
NEXT_PUBLIC_SETTLEMENT_PREFERENCE_REGISTRY=

# NEXT_PUBLIC_ARC_RPC_URL, not NEXT_PUBLIC_ARC_RPC. This template said the
# latter, which nothing reads (lib/chain.ts reads _URL), so a deployment that
# set it got the hardcoded public endpoint anyway -- and that endpoint is
# Cloudflare-fronted and rate-limits browsers, which surfaces as "Arc's public
# RPC is rate-limiting right now" on the history page and as failed reads
# elsewhere. Point this at a private endpoint in production.
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_CHAIN_ID=5042002
NEXT_PUBLIC_EXPLORER=https://testnet.arcscan.app
